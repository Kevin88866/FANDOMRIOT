{
  "name": "fandom-riot",
  "productName": "饭圈风云",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "python3 -m http.server 8123",
    "simulate": "node tools/simulate.mjs",
    "pack:win": "electron-packager . FandomRiot --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/dist --ignore=^/tools --ignore=^/node_modules/.bin",
    "pack:mac": "electron-packager . FandomRiot --platform=darwin --arch=arm64,x64 --out=dist --overwrite --ignore=^/dist --ignore=^/tools"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "33.2.1"
  }
}
